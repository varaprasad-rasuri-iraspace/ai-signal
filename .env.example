# AI Signal Backend Environment Variables
# ⚠️ SECURITY WARNING ⚠️
# This file contains example/placeholder values only
# Copy this to .env and replace with your actual credentials
# NEVER commit .env to Git!

# Database Connection
# For Supabase IPv6 (Direct Connection):
#   DATABASE_URL=postgresql+asyncpg://postgres.[PROJECT_REF]:[YOUR_PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres
# For Supabase IPv4 (Session Pooler - recommended):
#   DATABASE_URL=postgresql+asyncpg://postgres.[PROJECT_REF]:[YOUR_PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
# For Local PostgreSQL:
#   DATABASE_URL=postgresql+asyncpg://postgres:[YOUR_PASSWORD]@localhost:5432/ai_signal
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_signal

# App Settings
APP_NAME=AI Signal
APP_VERSION=1.0.0
DEBUG=true

# Database Pool Settings
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# AI Processing - OPTIONAL (leave empty to skip AI features)
# Get keys from:
# - OpenAI: https://platform.openai.com/api-keys
# - Anthropic: https://console.anthropic.com/settings/keys
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AI_MODEL=gpt-4-turbo-preview
AI_SUMMARY_MODEL=gpt-3.5-turbo

# Ingestion Settings
INGESTION_BATCH_SIZE=50
MAX_CONCURRENT_FETCHES=5
REQUEST_TIMEOUT=30

# Scoring Settings
TIME_DECAY_FACTOR=0.1
MIN_IMPORTANCE_SCORE=0.0
MAX_IMPORTANCE_SCORE=100.0

# API Settings
API_RATE_LIMIT=100
API_CACHE_TTL=300

# CORS - Allow frontend origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
